---
import Instrument from '@/layouts/Instrument.astro';
import Tool from '@/instruments/color/blend/Tool.svelte';
import { oneOf, parse, percent } from '@/instruments/color/defaults';
import { serializeWith } from '@/instruments/color/state';
import { BLEND_MODES } from '@duskresearch/primitives/design/color';

// Rendered per request so a shared link arrives with its colors, mode and amount in the HTML.
export const prerender = false;
const read = (q: URLSearchParams) => {
  const state = parse(q);
  const mode = oneOf(q.get('mode'), BLEND_MODES, 'mix');
  const amount = percent(q.get('amount'), 50);
  return { state, mode, amount, query: serializeWith(state, { mode, amount }) };
};
const { state, mode, amount, query } = read(Astro.url.searchParams);
const defaults = read(new URLSearchParams()).query;
---

<Instrument primitive="color" slug="blend" {query} {defaults}>
  <Tool client:load initial={state} {mode} {amount} />
</Instrument>
