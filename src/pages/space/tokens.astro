---
import Instrument from '@/layouts/Instrument.astro';
import Tool from '@/instruments/space/tokens/Tool.svelte';
import {parse,tokenOwn,serializeWith} from '@/instruments/space/state';
export const prerender=false;
const read=(q:URLSearchParams)=>{const state=parse(q),own=tokenOwn(q);return {state,own,query:serializeWith(state,own)};};
const {state,own,query}=read(Astro.url.searchParams);
const defaults=read(new URLSearchParams()).query;
---
<Instrument primitive="space" slug="tokens" {query} {defaults}><Tool client:load initial={state} {own}/></Instrument>
