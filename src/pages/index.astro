---
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Mark from '@/components/Mark.astro';
import { countLabel, counts, primitives, site, tint } from '@/lib/catalogue';

const description = `${site.subline} Contrast checks, modular scales, easing curves and more for color, type, grid, shape and motion. Free, no account, and every result is a link.`;
---

<Base title={`${site.name}: ${site.headline}`} description={description}>
  <div class="page">
    <Header />
    <main>
      <section class="hero">
        <h1>{site.headline}</h1>
        <div class="intro">
          <p>{site.subline}</p>
          <label class="search">
            <span class="visually-hidden">Search</span>
            <input data-spotlight-trigger type="text" placeholder={site.searchPlaceholder} autocomplete="off" spellcheck="false" />
            <span class="badge" aria-hidden="true">⌘K</span>
          </label>
        </div>
      </section>

      <section class="tiles" aria-label="Primitives">
        {
          primitives.map((p) => (
            <a class:list={['tile', { planned: !p.shipped }]} href={p.href} data-tile={p.slug} data-astro-prefetch style={`--tint:${tint(p)}`}>
              <span class="top mono">
                <span>{p.n}</span>
                <span class="count">{countLabel(p)}</span>
              </span>
              <span class="mark-box">
                <Mark primitive={p} size="var(--mark-tile)" />
              </span>
              <span class="bottom">
                <span class="name">{p.name}</span>
                <span class="list">{p.list}</span>
              </span>
            </a>
          ))
        }
        <form class="tile request" method="post" action="/api/request" novalidate data-form data-astro-reload data-confirm={site.requestConfirm} data-error={site.errorLine}>
          <span class="top mono"><span>{String(counts.primitives + 1)}</span><a class="all" href="/requests" data-astro-prefetch>All requests →</a></span>
          <label class="request-title" for="request-text">{site.requestTitle}</label>
          <span class="request-row">
            <input id="request-text" class="field" type="text" name="text" placeholder={site.requestPlaceholder} maxlength="200" autocomplete="off" />
            <input class="visually-hidden" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <button type="submit">Request</button>
          </span>
        </form>
      </section>
    </main>
    <Footer variant="full" />
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: end;
    padding: 56px var(--page-x) 28px;
  }
  h1 {
    font-size: 56px;
    line-height: 1;
    font-weight: 300;
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }
  .intro {
    justify-self: end;
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .intro p {
    font-size: 17px;
    line-height: 1.45;
    color: var(--ink-1);
  }
  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ink);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    padding: 4px 0;
    background: transparent;
    font-size: 15px;
    color: var(--ink);
    text-overflow: ellipsis;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--tile-gap);
    padding: 0 var(--page-x) 40px;
  }
  .tile {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--tile-pad);
    background: var(--tint);
    transition:
      transform var(--dur-lift) var(--ease-lift),
      opacity var(--dur-color);
  }
  a.tile:hover {
    transform: var(--lift);
  }
  a.tile:hover .name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .tile.dim {
    opacity: 0.25;
  }
  .top {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--ink-1);
  }
  .count {
    color: var(--ink-2);
  }
  .mark-box {
    height: var(--mark-box);
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .bottom {
    display: flex;
    flex-direction: column;
  }
  .name {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .planned .name {
    color: var(--ink-2);
  }
  .list {
    font-size: 13px;
    line-height: 1.3;
    color: var(--ink-2);
  }

  .request {
    grid-column: span 2;
    aspect-ratio: auto;
    gap: 16px;
    background: transparent;
    border: 1px dashed var(--line-3);
  }
  .all {
    color: var(--ink-2);
  }
  .all:hover {
    color: var(--ink);
  }
  .request-title {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: pretty;
  }
  .request-row {
    display: flex;
    gap: 8px;
    align-items: stretch;
  }
  .request-row .field {
    flex: 1;
  }
  .request button {
    border: 0;
    background: var(--ink);
    color: var(--paper);
    padding: 0 16px;
    font-size: 13px;
  }

  @media (max-width: 1099px) {
    h1 {
      font-size: 44px;
      line-height: 1.05;
      letter-spacing: -0.03em;
    }
    .tiles {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 899px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .intro {
      justify-self: start;
      max-width: 520px;
    }
  }

  @media (max-width: 719px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 44px var(--page-x) 24px;
    }
    h1 {
      font-size: 34px;
      letter-spacing: -0.03em;
    }
    .intro {
      justify-self: stretch;
      max-width: none;
    }
    .intro p {
      font-size: 15px;
      line-height: 1.4;
    }
    .tiles {
      grid-template-columns: repeat(2, 1fr);
      padding-bottom: 20px;
    }
    .top {
      font-size: 11px;
    }
    .name {
      font-size: 17px;
      letter-spacing: -0.01em;
    }
    .list {
      display: none;
    }
    .request {
      padding: 14px 12px;
      gap: 12px;
    }
    .request .top {
      justify-content: flex-end;
    }
    .request .top > span {
      display: none;
    }
    .request-title {
      font-size: 17px;
      letter-spacing: -0.01em;
    }
    .request-row .field {
      padding: 6px 0;
      font-size: 14px;
    }
    .request button {
      padding: 8px 12px;
    }
  }

  @media (orientation: landscape) and (max-height: 500px) {
    .hero {
      padding-top: 24px;
      padding-bottom: 20px;
    }
    h1 {
      font-size: 34px;
      line-height: 1.05;
    }
  }

  @media (pointer: coarse) {
    .request button {
      min-height: var(--min-hit);
    }
    .search input {
      min-height: var(--min-hit);
    }
    .all {
      padding-block: 15px;
      margin-block: -15px;
    }
    .search .badge {
      display: none;
    }
  }
</style>
