---
import Instrument from '@/layouts/Instrument.astro';
import Tool from '@/instruments/ratio/proportion/Tool.svelte';
import {parse,proportionOwn,serializeWith} from '@/instruments/ratio/state';
export const prerender=false;
const read=(q:URLSearchParams)=>{const state=parse(q),own=proportionOwn(q);return {state,own,query:serializeWith(state,own)};};
const {state,own,query}=read(Astro.url.searchParams);
const defaults=read(new URLSearchParams()).query;
---
<Instrument primitive="ratio" slug="proportion" {query} {defaults}><Tool client:load initial={state} {own}/></Instrument>
