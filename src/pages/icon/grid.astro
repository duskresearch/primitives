---
import Instrument from '@/layouts/Instrument.astro';
import Tool from '@/instruments/icon/grid/Tool.svelte';
import {parse,gridOwn,serializeWith} from '@/instruments/icon/state';
export const prerender=false;
const read=(q:URLSearchParams)=>{const state=parse(q),own=gridOwn(q,state.size);return {state,own,query:serializeWith(state,own)};};
const {state,own,query}=read(Astro.url.searchParams);
const defaults=read(new URLSearchParams()).query;
---
<Instrument primitive="icon" slug="grid" {query} {defaults}><Tool client:load initial={state} {own}/></Instrument>
