---
import Instrument from '@/layouts/Instrument.astro';
import Tool from '@/instruments/noise/gradient/Tool.svelte';
import {parse,gradientOwn,serializeWith} from '@/instruments/noise/state';
export const prerender=false;
const read=(q:URLSearchParams)=>{const state=parse(q),own=gradientOwn(q);return {state,own,query:serializeWith(state,own)};};
const {state,own,query}=read(Astro.url.searchParams);
const defaults=read(new URLSearchParams()).query;
---
<Instrument primitive="noise" slug="gradient" {query} {defaults}><Tool client:load initial={state} {own}/></Instrument>
