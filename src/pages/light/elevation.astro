---
import Instrument from '@/layouts/Instrument.astro';
import Tool from '@/instruments/light/elevation/Tool.svelte';
import {parse,elevationOwn,serializeWith} from '@/instruments/light/state';
export const prerender=false;
const read=(q:URLSearchParams)=>{const state=parse(q),own=elevationOwn(q);return {state,own,query:serializeWith(state,own)};};
const {state,own,query}=read(Astro.url.searchParams);
const defaults=read(new URLSearchParams()).query;
---
<Instrument primitive="light" slug="elevation" {query} {defaults}><Tool client:load initial={state} {own}/></Instrument>
