---
import Instrument from '@/layouts/Instrument.astro';
import Tool from '@/instruments/motion/spring/Tool.svelte';
import {parse,serializeWith} from '@/instruments/motion/state';
export const prerender=false;
const read=(q:URLSearchParams)=>{const state=parse(q);state.kind='spring';return {state,query:serializeWith(state)};};
const {state,query}=read(Astro.url.searchParams);
const defaults=read(new URLSearchParams()).query;
---
<Instrument primitive="motion" slug="spring" {query} {defaults}><Tool client:load initial={state}/></Instrument>
