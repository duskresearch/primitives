---
import Instrument from '@/layouts/Instrument.astro';
import Tool from '@/instruments/shape/favicon/Tool.svelte';
import { parse, faviconOwn, serializeWith } from '@/instruments/shape/state';
export const prerender = false;
const read=(q:URLSearchParams)=>{const state=parse(q),own=faviconOwn(q);return {state,own,query:serializeWith(state,own)}};
const {state,own,query}=read(Astro.url.searchParams);
const defaults=read(new URLSearchParams()).query;
---
<Instrument primitive="shape" slug="favicon" {query} {defaults}><Tool client:load initial={state} {own}/></Instrument>
