---
import Instrument from '@/layouts/Instrument.astro';
import Tool from '@/instruments/shape/form/Tool.svelte';
import { parse, formOwn, serializeWith } from '@/instruments/shape/state';
export const prerender = false;
const read = (q: URLSearchParams) => { const state = parse(q), own = formOwn(q); return { state, own, query: serializeWith(state, own) }; };
const { state, own, query } = read(Astro.url.searchParams);
const defaults = read(new URLSearchParams()).query;
---
<Instrument primitive="shape" slug="form" {query} {defaults}><Tool client:load initial={state} {own}/></Instrument>
