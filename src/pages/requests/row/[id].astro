---
// One board row as an HTML fragment, for the page to insert after a new suggestion.
import { bindings } from '#runtime-bindings';
import IdeaRow from '@/components/IdeaRow.astro';
import { idea } from '@/lib/server/ideas';
import { requireDb, visitor } from '@/lib/server/visitor';

export const prerender = false;
export const partial = true;

let binding;
try { binding = bindings(Astro.locals, Astro.request); }
catch { return new Response('Requests are temporarily unavailable.', { status: 503 }); }
let found;
try {
  const who = await visitor(Astro.request, binding);
  found = await idea(requireDb(binding.db), Astro.params.id ?? '', who.voter);
} catch {
  return new Response('Requests are temporarily unavailable.', { status: 503 });
}
if (!found) return new Response(null, { status: 404 });
Astro.response.headers.set('cache-control', 'private, no-store');
const rank = Number(Astro.url.searchParams.get('rank')) || 0;
---

<IdeaRow idea={found.idea} rank={rank} voted={found.voted} />
