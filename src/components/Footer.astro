---
// Footer. Every variant has the maker link and the status slot, the only place feedback
// appears. `full` (landing, about) adds the email line and the site links.
import { site, type Primitive } from '@/lib/catalogue';
import { links } from '@/lib/links';

interface Props {
  variant: 'full' | 'index' | 'instrument';
  next?: Primitive;
}

const { variant, next } = Astro.props;
const newTab = { target: '_blank', rel: 'noopener' };
---

<footer class:list={['footer', variant]}>
  <a class="maker" href={links.maker} {...newTab}>
    {site.maker}<span class="visually-hidden"> (opens in a new tab)</span>
  </a>
  {
    variant === 'full' && (
      <form class="notify" method="post" action="/api/subscribe" novalidate data-form data-astro-reload data-confirm={site.emailConfirm} data-error={site.errorLine}>
        <label for="notify-email">{site.emailLine}</label>
        <span class="notify-row">
          <input id="notify-email" class="field" type="email" name="email" placeholder="euclid@elements.gr" autocomplete="email" data-autosize />
          <input class="visually-hidden" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button type="submit"><span>{site.emailButton}</span></button>
        </span>
      </form>
    )
  }
  <span class="end">
    <span class="status" data-status role="status" aria-live="polite"></span>
    {
      variant === 'full' && (
        <nav class="site-links" aria-label="Site">
          <a href="/about" data-astro-prefetch>About</a>
          <a href={links.github} {...newTab}>
            GitHub<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
          <a href={links.twitter} {...newTab}>
            Twitter<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </nav>
      )
    }
    {
      variant === 'index' && next && (
        <a class="next" href={next.href} data-astro-prefetch>
          {next.name} {next.n} →
        </a>
      )
    }
  </span>
</footer>

<style>
  .footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 20px var(--page-x) 24px;
    border-top: 1px solid var(--line-1);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-2);
  }
  .instrument {
    margin-top: 56px;
  }
  .full {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
  }
  .maker {
    justify-self: start;
  }
  .end {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 20px;
    min-width: 0;
  }
  .status {
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .site-links {
    display: flex;
    gap: 20px;
  }
  .site-links a {
    color: var(--ink);
  }
  .footer a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .next {
    color: var(--ink-2);
  }
  .notify {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink-1);
  }
  /* The underline hugs the address as it is typed (the placeholder while empty), up to the
     spec's 180px, and "Notify me" follows it like the next word. The row keeps its full
     width so the centered footer line does not shift as the field grows. */
  .notify-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: calc(var(--email-input) + 70px);
  }
  .notify .field {
    field-sizing: content;
    width: auto;
    min-width: 1.5ch;
    max-width: var(--email-input);
    padding: 5px 0;
    font-size: 13px;
    line-height: 1.25;
  }
  .notify button {
    flex: none;
  }
  .notify button {
    border: 0;
    background: transparent;
    padding: 0;
    font-size: 13px;
    color: var(--ink);
  }
  /* Underlined the way the field is (same line height, padding and rule), so the two lines
     sit level in any font, the fallbacks included. */
  .notify button span {
    display: block;
    padding-bottom: 5px;
    border-bottom: 1px solid currentColor;
    line-height: 1.25;
  }
  @media (pointer: coarse) {
    /* Natural height, so the underline and the focus ring hug the address. On a phone the
       label sits flush above and focuses the field too; together they clear 44px. */
    .notify .field {
      min-height: 0;
    }
    .notify button,
    .footer a {
      min-height: var(--min-hit);
      min-width: var(--min-hit);
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }
  /* Under 900px the three columns no longer fit beside the email line: it takes its own
     row, then any status message, then the maker and the site links. */
  @media (max-width: 899px) {
    .full {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 20px;
    }
    .full .end {
      display: contents;
    }
    .full .notify {
      order: -2;
      width: 100%;
    }
    .full .status {
      order: -1;
      width: 100%;
    }
    .full .status:empty {
      display: none;
    }
    .full .site-links {
      margin-left: auto;
    }
  }
  @media (max-width: 719px) {
    .footer {
      padding: 16px var(--page-x) 22px;
      font-size: 11px;
    }
    /* Phone: the label above the field. */
    .full .notify {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .full .notify label {
      padding-bottom: 4px;
    }
    .notify-row {
      min-width: 0;
    }
    .notify .field {
      flex: 0 1 auto;
      max-width: 100%;
    }
  }
</style>
