{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Astro's Cloudflare adapter supplies `main` and the static assets binding.
  "name": "primitives",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // The site answers on primitiv.es only; www is redirected by workers/www-redirect.
  "routes": [{ "pattern": "primitiv.es", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // Suggestions, votes, request log, subscribers and rate-limit counters (migrations/).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "primitives",
      "database_id": "a2f50db2-ba1a-4296-9d35-7af8bfa4eda4",
      "migrations_dir": "migrations"
    }
  ]

  // Secrets (wrangler secret put <NAME>):
  //   VOTE_SALT  salts the hashes that stand in for visitors (votes, rate limits). Locally
  //              it comes from .dev.vars.
}
